    "package": "equinix.fabric.v1",
    "datatype": "equinix.fabric.v1.AppConnectEvent",
    "domain": "Equinix Fabric Application Connect Event",
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/Data",
    "definitions": {
        "Data": {
            "properties": {
                "message": {
                    "type": "string",
                    "description": "Supporting message describing the event"
                },
                "resource": {
                    "$ref": "#/definitions/Resource",
                    "additionalProperties": true,
                    "description": "The Application Connect resource that fired the event"
                },
                "auth": {
                    "$ref": "#/definitions/Auth",
                    "additionalProperties": true,
                    "description": "The auth context within all AppConnectEvent events."
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "ChangeEvent Event Data",
            "description": "The data within all AppConnectEvent events."
        },
        "Auth": {
            "properties": {
                "type": {
                    "type": "string",
                    "description": "The type of the entity generating the event: user for user-initiated transitions, system for platform-confirmed transitions"
                },
                "id": {
                    "type": "string",
                    "description": "The unique identifier of the user generating the event. Omitted when type is system"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Auth",
            "description": "Auth information of the generated event"
        },
        "Resource": {
            "properties": {
                "href": {
                    "type": "string",
                    "description": "Link to the resource that has generated the event"
                },
                "uuid": {
                    "type": "string",
                    "description": "Equinix assigned unique identifier of the resource generating the event. For attachment events, the UUID of the attached Application Domain, Service, or Processor"
                },
                "type": {
                    "type": "string",
                    "description": "Type of the resource generating the event: APP_LINK, APP_DOMAIN, APP_SERVICE, APP_SUBSCRIPTION, or APP_PROCESSOR"
                },
                "name": {
                    "type": "string",
                    "description": "Name of the resource generating the event. Omitted for resources without a name, such as Application Subscription, and for attachment events"
                },
                "state": {
                    "type": "string",
                    "description": "State of the resource generating the event. Omitted for attachment events, which use attachmentStatus instead"
                },
                "attachmentStatus": {
                    "type": "string",
                    "description": "Attachment status of the Application Domain, Service, or Processor on the Application Link. Set only for attachment events"
                },
                "geoScope": {
                    "type": "string",
                    "description": "Geographic scope of the Application Service attachment. Set only for Application Service attachment events"
                },
                "destinationIp": {
                    "type": "string",
                    "description": "Destination IP address of the Application Service attachment. Set only for Application Service attachment events"
                },
                "config": {
                    "type": "string",
                    "description": "Base64-encoded model configuration of the Application Processor attachment. Set only for Application Processor attachment events"
                },
                "endpoint": {
                    "type": "string",
                    "description": "Endpoint of the Application Processor attachment. Set only for Application Processor attachment events"
                },
                "change": {
                    "$ref": "#/definitions/Change",
                    "additionalProperties": true,
                    "description": "The attribute change on the resource. Set only for attribute change events"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Resource",
            "description": "Schema of the resource that fired the event"
        },
        "Change": {
            "properties": {
                "uuid": {
                    "type": "string",
                    "description": "Uuid of the change for the resource target of the event"
                },
                "type": {
                    "type": "string",
                    "description": "Type of the change happening on the resource, such as APP_LINK_UPDATE"
                },
                "status": {
                    "type": "string",
                    "description": "Status of the change on the resource: REQUESTED, COMPLETED, or FAILED"
                },
                "createdDateTime": {
                    "type": "string",
                    "description": "The time that the change was created",
                    "format": "date-time"
                },
                "updatedDateTime": {
                    "type": "string",
                    "description": "The time that the change was last updated",
                    "format": "date-time"
                },
                "data": {
                    "type": "array",
                    "description": "JSON Patch operations of the change",
                    "items": {
                        "$ref": "#/definitions/ChangeData"
                    }
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Change",
            "description": "Change attribute schema"
        },
        "ChangeData": {
            "properties": {
                "op": {
                    "type": "string",
                    "description": "The JSON Patch operation performed on the resource under change"
                },
                "path": {
                    "type": "string",
                    "description": "The attribute on the resource being changed"
                },
                "value": {
                    "type": "string",
                    "description": "The new value of the attribute under change"
                },
                "previousValue": {
                    "type": "string",
                    "description": "The previous value of the attribute under change"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "ChangeData",
            "description": "ChangeData attribute schema"
        }
    },
